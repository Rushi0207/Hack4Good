# Values are available from your Supabase project's API settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ─── Bootstrap only (remove after first admin is set) ────────────────────────
# Used ONLY by: npm run bootstrap:admin  AND  POST /api/teams/:id/invite
# Never prefix with NEXT_PUBLIC_ — must never reach the browser.
# Find it in: Supabase Dashboard → Project Settings → API → service_role (secret)
# Remove from .env.local immediately after running bootstrap:admin successfully.
# Keep it present if you want invite-by-email to work (team invitation emails).
SUPABASE_SERVICE_ROLE_KEY=

# ─── Frontend site URL (used in email links) ──────────────────────────────────
# The URL where the frontend is running. Used to build redirect links in emails.
# Development:  http://localhost:3001
# Production:   https://your-frontend-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3001
