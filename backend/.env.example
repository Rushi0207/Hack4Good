# Values are available from your Supabase project's API settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ─── Bootstrap only (remove after first admin is set) ────────────────────────
# Used ONLY by: npm run bootstrap:admin
# Never prefix with NEXT_PUBLIC_ — must never reach the browser.
# Find it in: Supabase Dashboard → Project Settings → API → service_role (secret)
# Remove from .env.local immediately after running bootstrap:admin successfully.
SUPABASE_SERVICE_ROLE_KEY=
